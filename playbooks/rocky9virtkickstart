cat << EOF > /var/lib/libvirt/images/ks.cfg
# Use CDROM installation media
cdrom
# Set language, keyboard, and timezone
lang en_US.UTF-8
keyboard us
timezone Australia/Sydney --utc
# Set root password (use --plaintext for simplicity, or hash for security)
rootpw --plaintext MySecurePass123
# Create a user (optional, with sudo privileges)
user --name=user --password=UserPass123 --groups=wheel
# Configure network to use DHCP on the first interface
network --bootproto=dhcp --device=eth0 --onboot=on
# Clear disk and set up automatic partitioning
zerombr
clearpart --all --initlabel
autopart
# Reboot after installation
reboot
# Install minimal package set and SSH server
%packages
@^minimal-environment
openssh-server
%end
# Enable SSH and firewall rules in post-install
%post
systemctl enable sshd
firewall-cmd --add-service=ssh --permanent
firewall-cmd --reload
%end
EOF




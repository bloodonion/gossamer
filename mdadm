---
- name: Configure software RAID (mdadm) on Rocky Linux 9.6 - dynamic number of drives
  hosts: all
  become: true
  vars:
    # === CUSTOMIZE HERE ===
    # Define one or more RAID arrays. The number of hard drives per array is fully dynamic
    # (just change the length of the "devices" list).
    # Supported RAID levels: 0, 1, 5, 6, 10, etc.
    raid_arrays:
      - name: /dev/md0                  # RAID device name
        level: 5                        # Change to 0, 1, 10, etc. as needed
        devices:                        # ← Dynamic amount of drives (add/remove as needed)
          - /dev/sdb
          - /dev/sdc
          - /dev/sdd
          - /dev/sde
        filesystem: xfs                 # xfs (default for Rocky) or ext4
        mount_point: /data/raid         # Set to empty string if you don't want to mount
        mount_opts: defaults,noatime,nobarrier

      # Example of a second array with a different number of drives (fully dynamic):
      # - name: /dev/md1
      #   level: 0
      #   devices:
      #     - /dev/sdf
      #     - /dev/sdg
      #   filesystem: ext4
      #   mount_point: /data/scratch
      #   mount_opts: defaults,noatime

  tasks:
    - name: Install mdadm (Rocky Linux 9.6 / RHEL family)
      ansible.builtin.dnf:
        name: mdadm
        state: present
        update_cache: true

    - name: Check for existing RAID arrays
      ansible.builtin.command:
        cmd: "mdadm --detail {{ item.name }}"
      loop: "{{ raid_arrays }}"
      register: existing_raids
      changed_when: false
      failed_when: false

    - name: Zero superblocks on member disks (only for new arrays - wipes data!)
      ansible.builtin.command:
        cmd: "mdadm --zero-superblock {{ item.1 }}"
      loop: "{{ raid_arrays | subelements('devices') }}"
      when: existing_raids.results[raid_arrays.index(item.0)].rc != 0
      loop_control:
        label: "{{ item.1 }}"
      failed_when: false

    - name: Create the RAID arrays (idempotent - only runs if array does not exist)
      ansible.builtin.command:
        cmd: >
          mdadm --create {{ item.name }}
          --level={{ item.level }}
          --raid-devices={{ item.devices | length }}
          {{ item.devices | join(' ') }}
          --run
      loop: "{{ raid_arrays }}"
      when: existing_raids.results[raid_arrays.index(item)].rc != 0
      loop_control:
        label: "{{ item.name }}"

    - name: Wait briefly for initial sync to begin
      ansible.builtin.pause:
        seconds: 10
      when: existing_raids.results | selectattr('rc', 'ne', 0) | list | length > 0

    - name: Create filesystem on the RAID device
      community.general.filesystem:
        fstype: "{{ item.filesystem }}"
        dev: "{{ item.name }}"
      loop: "{{ raid_arrays }}"

    - name: Create mount point directories (if mount_point is defined)
      ansible.builtin.file:
        path: "{{ item.mount_point }}"
        state: directory
        mode: '0755'
      loop: "{{ raid_arrays }}"
      when: item.mount_point | default('') | length > 0

    - name: Mount the RAID arrays
      ansible.posix.mount:
        path: "{{ item.mount_point }}"
        src: "{{ item.name }}"
        fstype: "{{ item.filesystem }}"
        opts: "{{ item.mount_opts }}"
        state: mounted
      loop: "{{ raid_arrays }}"
      when: item.mount_point | default('') | length > 0

    - name: Save RAID configuration to /etc/mdadm.conf (for boot persistence)
      ansible.builtin.shell:
        cmd: mdadm --detail --scan >> /etc/mdadm.conf
      changed_when: true
      when: existing_raids.results | selectattr('rc', 'ne', 0) | list | length > 0

    - name: Update initramfs (dracut) so RAID assembles at boot
      ansible.builtin.command:
        cmd: dracut --force
      changed_when: true
      when: existing_raids.results | selectattr('rc', 'ne', 0) | list | length > 0

    - name: Enable and start mdmonitor service (for RAID event monitoring)
      ansible.builtin.systemd:
        name: mdmonitor
        enabled: true
        state: started
